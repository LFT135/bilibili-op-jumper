{
  "manifest_version": 3,
  "name": "B站一键跳过番剧片头(增强版)",
  "version": "1.0",
  "description": "支持自定义触发键位和跳过时长的B站跳过片头插件，兼容Chrome和Edge浏览器",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/bangumi/play/*",
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/list/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
